      <item row="2" column="1">
       <widget class="QComboBox" name="directionComboBox">
        <item><property name="text"><string>N</string></property></item>
        <item><property name="text"><string>S</string></property></item>
        <item><property name="text"><string>E</string></property></item>
        <item><property name="text"><string>W</string></property></item>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- Platform topology -->
   <item>
    <widget class="QGroupBox" name="platformGroup">
     <property name="title"><string>Platform topology</string></property>
     <layout class="QFormLayout" name="platformForm">
      <item row="0" column="0">
       <widget class="QLabel"><property name="text"><string>Platform exits (comma-separated):</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="exitsEdit">
        <property name="placeholderText"><string>e.g. A,B,C,D</string></property>
        <property name="toolTip"><string>One letter per staircase/exit from the platform</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel"><property name="text"><string>Underground levels:</string></property></widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="levelsSpinBox">
        <property name="minimum"><number>1</number></property>
        <property name="maximum"><number>8</number></property>
        <property name="value"><number>2</number></property>
        <property name="toolTip"><string>Number of underground levels (1 = platform at level 1, street at 0)</string></property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel"><property name="text"><string>Has booking hall:</string></property></widget>
      </item>
      <item row="2" column="1">
       <widget class="QCheckBox" name="bookingHallCheck">
        <property name="checked"><bool>true</bool></property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel"><property name="text"><string>Has street exits:</string></property></widget>
      </item>
      <item row="3" column="1">
       <widget class="QCheckBox" name="streetExitsCheck">
        <property name="checked"><bool>true</bool></property>
        <property name="toolTip"><string>Add a StreetExit leaf node at ground level per exit</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

