        <item><property name="text"><string>Cen</string></property></item>
        <item><property name="text"><string>Ntn</string></property></item>
        <item><property name="text"><string>Vic</string></property></item>
        <item><property name="text"><string>Bak</string></property></item>
        <item><property name="text"><string>Dist</string></property></item>
        <item><property name="text"><string>Met</string></property></item>
        <item><property name="text"><string>Jub</string></property></item>
        <item><property name="text"><string>Pic</string></property></item>
        <item><property name="text"><string>Cir</string></property></item>
        <item><property name="text"><string>Ham</string></property></item>
        <item><property name="text"><string>Wat</string></property></item>
        <item><property name="text"><string>Eli</string></property></item>
