        <property name="text"><string><i>Or fill in manually below</i></string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- Station identity -->
   <item>
    <widget class="QGroupBox" name="identityGroup">
     <property name="title"><string>Station identity</string></property>
     <layout class="QFormLayout" name="identityForm">
      <item row="0" column="0">
       <widget class="QLabel"><property name="text"><string>Station code (3-letter):</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="stationCodeEdit">
        <property name="placeholderText"><string>e.g. CHL</string></property>
        <property name="maxLength"><number>10</number></property>
       </widget>
      </item>
      <item row="1" column="0">
